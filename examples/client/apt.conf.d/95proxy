# /etc/apt/apt.conf.d/95proxy на клиенте Ubuntu 26.04.
# 192.168.0.10 замените на адрес прокси. Схема https-строки тоже http:
# apt открывает через прокси туннель CONNECT, а не говорит с ним по TLS.
# На сервере Squid этот файл не ставят.

Acquire::http::Proxy "http://192.168.0.10:3128";
Acquire::https::Proxy "http://192.168.0.10:3128";
