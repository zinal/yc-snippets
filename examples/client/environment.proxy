# Строки для добавления в /etc/environment на клиенте.
# Это не весь файл: в /etc/environment уже есть PATH, его оставляют.
# export здесь не пишут. 192.168.0.10 замените на адрес прокси.

http_proxy="http://192.168.0.10:3128"
https_proxy="http://192.168.0.10:3128"
HTTP_PROXY="http://192.168.0.10:3128"
HTTPS_PROXY="http://192.168.0.10:3128"
no_proxy="localhost,127.0.0.1,::1,192.168.0.0/16"
NO_PROXY="localhost,127.0.0.1,::1,192.168.0.0/16"
